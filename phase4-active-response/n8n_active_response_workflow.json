            "n7"
          ]
        ]
      }
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "/wazuh-ar-approval",
        "responseMode": "lastNode",
        "options": {},
        "timeout": 3600
      },
      "name": "Wait for Approval",
      "type": "n8n-nodes-base.webhookWait",
