{
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "/wazuh-ar-decision",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Receive AI Decision",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "id": "n1"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.decision_type}}",
              "operation": "equal",
              "value2": "AUTO"
            }
          ]
        }
      },
      "name": "If AUTO or RECOMMEND",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "id": "n2",
      "executeOnSuccess": true,
      "connections": {
        "main": [
          [
            "n3"
          ],
          [
            "n6"
          ]
        ]
      }
    },
    {
      "parameters": {
        "url": "=https://your-wazuh-api-url/active-response",
        "method": "POST",
        "body": "={{JSON.stringify($json.wazuh_ar_payload)}}",
        "jsonParameters": true,
        "options": {},
        "authentication": "predefined",
        "predefinedAuth": {
          "authMethod": "headerAuth",
          "headerAuth": {
            "name": "Authorization",
            "value": "Bearer {{ $credentials.wazuhApiToken }}"
          }
        }
      },
      "name": "Trigger Wazuh AR (AUTO)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "id": "n3",
      "credentials": {
        "httpHeaderAuth": [
          "wazuhApiCredentials"
        ]
      },
      "connections": {
        "main": [
          [
            "n4"
          ]
        ]
      }
    },
    {
      "parameters": {
        "url": "=https://your-qdrant-url/collections/wazuh_ar_logs/points",
        "method": "POST",
        "body": "={\"points\": [{\"id\": \"{{$json.alert_id}}\", \"payload\": {\"timestamp\": \"{{$json.timestamp}}\", \"action\": \"{{$json.action}}\", \"decision_type\": \"AUTO\", \"status\": \"Success\", \"wazuh_response\": \"{{JSON.stringify($json)}}\"}}]}",
        "jsonParameters": true,
        "options": {},
        "authentication": "predefined",
        "predefinedAuth": {
          "authMethod": "headerAuth",
          "headerAuth": {
            "name": "api-key",
            "value": "{{ $credentials.qdrantApiKey }}"
          }
        }
      },
      "name": "Log to Qdrant (AUTO)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "id": "n4",
      "credentials": {
        "httpHeaderAuth": [
          "qdrantCredentials"
        ]
      },
      "connections": {
        "main": [
          [
            "n5"
          ]
        ]
      }
    },
    {
      "parameters": {
        "chatId": "1721493612",
        "text": "Wazuh Active Response (AUTO) triggered successfully for alert ID: {{$json.alert_id}} (Action: {{$json.action}}).",
        "options": {}
      },
      "name": "Telegram Confirmation (AUTO)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "id": "n5",
      "credentials": {
        "telegramApi": [
          "telegramBotApi"
        ]
      }
    },
    {
      "parameters": {
        "chatId": "1721493612",
        "text": "Wazuh AI Agent recommends active response for alert ID: {{$json.alert_id}} (Action: {{$json.action}}). Approve or Deny? [Approve: {{ $workflow.webhookUrls.n7 }}/approve?alert_id={{$json.alert_id}}&action={{$json.action}}&token=YOUR_SECRET_TOKEN] [Deny: {{ $workflow.webhookUrls.n7 }}/deny?alert_id={{$json.alert_id}}&action={{$json.action}}&token=YOUR_SECRET_TOKEN]",
        "options": {}
      },
      "name": "Telegram Approval Request",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "id": "n6",
      "credentials": {
