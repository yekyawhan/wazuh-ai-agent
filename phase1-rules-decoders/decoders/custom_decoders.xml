<!--
  ============================================================
  CUSTOM DECODERS FOR WAZUH SIEM
  ============================================================
  
  What are Decoders?
  - Decoders extract structured fields from raw log messages
  - They run BEFORE rules - rules use the extracted fields
  - Parent decoder identifies the log source
  - Child decoders extract specific fields from that source
  
  How to add new decoders:
  1. Identify the log format (syslog, JSON, custom text)
  2. Create a parent decoder with a unique name and prematch
  3. Create child decoders with regex to extract fields
  4. Test with: /var/ossec/bin/wazuh-logtest
  
  Relationship to Rules:
  - Decoders extract: decoded_as, srcip, dstip, user, etc.
  - Rules match on: decoded_as, srcip, dstip, user, etc.
  - Without proper decoders, rules cannot trigger correctly
  
  Deploy to: /var/ossec/etc/decoders/custom_decoders.xml
  Test with: /var/ossec/bin/wazuh-logtest (paste raw log)
  ============================================================
-->

<!-- ============================================================
     SECTION 1: SURICATA EVE.JSON DECODERS
     Parses Suricata's JSON alert output from eve.json
     Log source: /var/log/suricata/eve.json
     ============================================================ -->

<decoder name="suricata-eve">
  <prematch>^{"timestamp"</prematch>
</decoder>

<decoder name="suricata-eve-alert">
  <parent>suricata-eve</parent>
  <prematch>"event_type":"alert"</prematch>
  <regex>"signature":"(\.+)","signature_id":(\d+)</regex>
  <order>data.signature, data.signature_id</order>
</decoder>

<decoder name="suricata-eve-alert-src">
  <parent>suricata-eve</parent>
  <prematch>"event_type":"alert"</prematch>
  <regex>"src_ip":"(\S+)","src_port":(\d+),"dest_ip":"(\S+)","dest_port":(\d+)</regex>
  <order>srcip, srcport, dstip, dstport</order>
</decoder>

<decoder name="suricata-eve-alert-severity">
  <parent>suricata-eve</parent>
  <prematch>"event_type":"alert"</prematch>
  <regex>"severity":(\d+),"category":"(\.+)"</regex>
  <order>data.severity, data.category</order>
</decoder>

<decoder name="suricata-eve-alert-action">
  <parent>suricata-eve</parent>
  <prematch>"event_type":"alert"</prematch>
  <regex>"action":"(\w+)"</regex>
  <order>data.action</order>
</decoder>

<decoder name="suricata-eve-alert-proto">
  <parent>suricata-eve</parent>
  <prematch>"event_type":"alert"</prematch>
  <regex>"proto":"(\w+)"</regex>
  <order>protocol</order>
</decoder>

<decoder name="suricata-eve-flow">
  <parent>suricata-eve</parent>
  <prematch>"event_type":"flow"</prematch>
  <regex>"src_ip":"(\S+)","src_port":(\d+),"dest_ip":"(\S+)","dest_port":(\d+)</regex>
  <order>srcip, srcport, dstip, dstport</order>
</decoder>

<decoder name="suricata-eve-dns">
  <parent>suricata-eve</parent>
  <prematch>"event_type":"dns"</prematch>
  <regex>"rrname":"(\.+?)","rrtype":"(\w+)"</regex>
  <order>data.dns_query, data.dns_type</order>
</decoder>

<!-- ============================================================
     SECTION 2: PSTOOL DECODERS
     Parses PSTool output for unwanted software detection
     Log source: Windows Event Log / Wazuh agent
     ============================================================ -->

<decoder name="pstool-output">
  <prematch>^PSTool:</prematch>
</decoder>

<decoder name="pstool-process-detected">
  <parent>pstool-output</parent>
  <prematch>ProcessDetected</prematch>
  <regex>ProcessDetected\|Name:(\.+)\|PID:(\d+)\|User:(\.+)\|Path:(\.+)\|Vendor:(\.+)\|Department:(\.+)\|Action:(\w+)</regex>
  <order>data.process_name, data.pid, srcuser, data.process_path, data.vendor, data.department, data.action</order>
</decoder>

<decoder name="pstool-process-blocked">
  <parent>pstool-output</parent>
  <prematch>ProcessBlocked</prematch>
  <regex>ProcessBlocked\|Name:(\.+)\|PID:(\d+)\|User:(\.+)\|Reason:(\.+)</regex>
  <order>data.process_name, data.pid, srcuser, data.reason</order>
</decoder>

<decoder name="pstool-process-suspended">
  <parent>pstool-output</parent>
  <prematch>ProcessSuspended</prematch>
  <regex>ProcessSuspended\|Name:(\.+)\|PID:(\d+)\|User:(\.+)\|Duration:(\d+)</regex>
  <order>data.process_name, data.pid, srcuser, data.duration</order>
</decoder>

<decoder name="pstool-scan-complete">
  <parent>pstool-output</parent>
  <prematch>ScanComplete</prematch>
  <regex>ScanComplete\|Total:(\d+)\|Blocked:(\d+)\|Allowed:(\d+)\|Host:(\.+)</regex>
  <order>data.total_processes, data.blocked_count, data.allowed_count, data.hostname</order>
</decoder>

<!-- ============================================================
     SECTION 3: POWERSHELL SCRIPT BLOCK LOGGING DECODERS
     Parses Windows PowerShell script execution events
     Event IDs: 4103, 4104 (Script Block Logging)
     ============================================================ -->

<decoder name="powershell-scriptblock">
  <prematch>^PowerShell|ScriptBlock</prematch>
</decoder>

<decoder name="powershell-scriptblock-4104">
  <parent>powershell-scriptblock</parent>
  <prematch>EventID: 4104</prematch>
  <regex>ScriptBlockText=(\.+)\|Path=(\.+)\|ScriptBlockId=(\.+)\|User=(\.+)</regex>
  <order>data.script_content, data.script_path, data.script_id, srcuser</order>
</decoder>

<decoder name="powershell-scriptblock-4103">
  <parent>powershell-scriptblock</parent>
  <prematch>EventID: 4103</prematch>
  <regex>CommandName=(\.+)\|CommandType=(\w+)\|User=(\.+)\|Host=(\.+)</regex>
  <order>data.command_name, data.command_type, srcuser, data.hostname</order>
</decoder>

<decoder name="powershell-encoded">
  <parent>powershell-scriptblock</parent>
  <prematch>-EncodedCommand|-enc|-e </prematch>
  <regex>(-EncodedCommand|-enc|-e)\s+(\.+)</regex>
  <order>data.encoding_flag, data.encoded_payload</order>
</decoder>

<!-- ============================================================
     SECTION 4: DOCKER CONTAINER & SWARM DECODERS
     Parses Docker daemon logs and container output
     Log source: /var/log/docker.log, journald
     ============================================================ -->

<decoder name="docker-daemon">
  <prematch>^dockerd|^containerd|docker\[\d+\]</prematch>
</decoder>

<decoder name="docker-container-event">
  <parent>docker-daemon</parent>
  <prematch>container \w+</prematch>
  <regex>container (\w+)\s+(\w+)\s+\(image=(\.+?), name=(\.+?)\)</regex>
  <order>data.container_id, data.action, data.image, data.container_name</order>
</decoder>

<decoder name="docker-swarm-event">
  <parent>docker-daemon</parent>
  <prematch>swarm</prematch>
  <regex>swarm\s+(\.+?)\s+node=(\.+?)\s+service=(\.+?)\s+status=(\w+)</regex>
  <order>data.swarm_event, data.node, data.service, data.status</order>
</decoder>

<decoder name="docker-health-check">
  <parent>docker-daemon</parent>
  <prematch>health_status</prematch>
  <regex>health_status:\s+(\w+)\s+container=(\.+?)\s+image=(\.+)</regex>
  <order>data.health_status, data.container_name, data.image</order>
</decoder>

<decoder name="docker-json-log">
  <prematch>^{"log":"</prematch>
</decoder>

<decoder name="docker-json-log-fields">
  <parent>docker-json-log</parent>
  <regex>"log":"(\.+?)","stream":"(\w+)","time":"(\.+?)"</regex>
  <order>data.log_message, data.stream, data.timestamp</order>
</decoder>

<!-- ============================================================
     SECTION 5: CLOUDFLARE TUNNEL (cloudflared) DECODERS
     Parses cloudflared connection and tunnel logs
     Log source: journald / /var/log/cloudflared.log
     ============================================================ -->

<decoder name="cloudflared">
  <prematch>^cloudflared|INF |ERR |WRN </prematch>
</decoder>

<decoder name="cloudflared-connection">
  <parent>cloudflared</parent>
  <prematch>Connection \w+ registered</prematch>
  <regex>Connection (\S+) registered with connIndex=(\d+) ip=(\S+) location=(\S+)</regex>
  <order>data.connection_id, data.conn_index, srcip, data.location</order>
</decoder>

<decoder name="cloudflared-tunnel-event">
  <parent>cloudflared</parent>
  <prematch>tunnel event</prematch>
  <regex>tunnel event type=(\w+) tunnel_id=(\S+) origin_url=(\.+)</regex>
  <order>data.event_type, data.tunnel_id, data.origin_url</order>
</decoder>

<decoder name="cloudflared-request">
  <parent>cloudflared</parent>
  <prematch>Request URL</prematch>
  <regex>Request URL (\S+) from (\S+) status=(\d+) duration=(\.+)</regex>
  <order>url, srcip, data.http_status, data.duration</order>
</decoder>

<decoder name="cloudflared-error">
  <parent>cloudflared</parent>
  <prematch>ERR </prematch>
  <regex>ERR (\.+?) error="(\.+?)"</regex>
  <order>data.error_context, data.error_message</order>
</decoder>

<decoder name="cloudflared-disconnect">
  <parent>cloudflared</parent>
  <prematch>Unregistered tunnel connection</prematch>
  <regex>Unregistered tunnel connection connIndex=(\d+)</regex>
  <order>data.conn_index</order>
</decoder>

<!-- ============================================================
     SECTION 6: ENHANCED AUTHENTICATION DECODERS
     Enhanced parsing for SSH, RDP, and Windows logon events
     ============================================================ -->

<decoder name="auth-enhanced">
  <prematch>^sshd\[\d+\]|Failed password|Accepted password|authentication failure</prematch>
</decoder>

<decoder name="auth-ssh-failed">
  <parent>auth-enhanced</parent>
  <prematch>Failed password</prematch>
  <regex>Failed password for (invalid user )?(\S+) from (\S+) port (\d+) (\w+)</regex>
  <order>data.invalid_user, srcuser, srcip, srcport, data.auth_method</order>
</decoder>

<decoder name="auth-ssh-success">
  <parent>auth-enhanced</parent>
  <prematch>Accepted password|Accepted publickey</prematch>
  <regex>Accepted (\w+) for (\S+) from (\S+) port (\d+) (\w+)</regex>
  <order>data.auth_method, srcuser, srcip, srcport, data.key_type</order>
</decoder>

<decoder name="auth-ssh-bruteforce">
  <parent>auth-enhanced</parent>
  <prematch>maximum authentication attempts</prematch>
  <regex>maximum authentication attempts exceeded for (invalid user )?(\S+) from (\S+) port (\d+)</regex>
  <order>data.invalid_user, srcuser, srcip, srcport</order>
</decoder>

<decoder name="windows-logon-enhanced">
  <prematch>EventID: 4624|EventID: 4625|EventID: 4648</prematch>
</decoder>

<decoder name="windows-logon-success">
  <parent>windows-logon-enhanced</parent>
  <prematch>EventID: 4624</prematch>
  <regex>LogonType=(\d+)\|User=(\.+?)\|Domain=(\.+?)\|SourceIP=(\.+?)\|WorkstationName=(\.+?)\|LogonProcess=(\.+)</regex>
  <order>data.logon_type, srcuser, data.domain, srcip, data.workstation, data.logon_process</order>
</decoder>

<decoder name="windows-logon-failed">
  <parent>windows-logon-enhanced</parent>
  <prematch>EventID: 4625</prematch>
  <regex>LogonType=(\d+)\|User=(\.+?)\|Domain=(\.+?)\|SourceIP=(\.+?)\|FailureReason=(\.+?)\|Status=(\.+)</regex>
  <order>data.logon_type, srcuser, data.domain, srcip, data.failure_reason, data.status_code</order>
</decoder>

<!-- ============================================================
     SECTION 7: GENERIC JSON APPLICATION LOG DECODER
     Handles any JSON-formatted application log
     ============================================================ -->

<decoder name="json-app-log">
  <prematch>^{"level":|^{"severity":|^{"msg":</prematch>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<decoder name="json-app-log-fields">
  <parent>json-app-log</parent>
  <regex>"level":"(\w+)","msg":"(\.+?)","time":"(\.+?)"</regex>
  <order>data.level, data.message, data.timestamp</order>
</decoder>

<!-- ============================================================
     SECTION 8: WAZUH ACTIVE RESPONSE FEEDBACK DECODERS
     Parses feedback from active response script execution
     ============================================================ -->

<decoder name="ar-feedback">
  <prematch>^AR-Feedback:</prematch>
</decoder>

<decoder name="ar-feedback-success">
  <parent>ar-feedback</parent>
  <prematch>SUCCESS</prematch>
  <regex>AR-Feedback:SUCCESS\|Command:(\.+?)\|Agent:(\d+)\|Target:(\.+?)\|Duration:(\d+)ms</regex>
  <order>data.ar_command, data.agent_id, data.target, data.duration</order>
</decoder>

<decoder name="ar-feedback-failed">
  <parent>ar-feedback</parent>
  <prematch>FAILED</prematch>
  <regex>AR-Feedback:FAILED\|Command:(\.+?)\|Agent:(\d+)\|Error:(\.+)</regex>
  <order>data.ar_command, data.agent_id, data.error</order>
</decoder>

<!-- ============================================================
     SECTION 9: AI AGENT RESPONSE DECODERS
     Parses logs from the AI Agent itself (for monitoring)
     ============================================================ -->

<decoder name="ai-agent-log">
  <prematch>^AI-Agent:</prematch>
</decoder>

<decoder name="ai-agent-classification">
  <parent>ai-agent-log</parent>
  <prematch>Classification</prematch>
  <regex>AI-Agent:Classification\|AlertID:(\.+?)\|ThreatType:(\.+?)\|Confidence:(\S+)\|MITRE:(\.+?)\|Action:(\.+)</regex>
  <order>data.alert_id, data.threat_type, data.confidence, data.mitre_technique, data.recommended_action</order>
</decoder>

<decoder name="ai-agent-response">
  <parent>ai-agent-log</parent>
  <prematch>Response</prematch>
  <regex>AI-Agent:Response\|AlertID:(\.+?)\|Action:(\.+?)\|Status:(\w+)\|Approved:(true|false)</regex>
  <order>data.alert_id, data.action_taken, data.status, data.human_approved</order>
</decoder>

<decoder name="ai-agent-error">
  <parent>ai-agent-log</parent>
  <prematch>Error</prematch>
  <regex>AI-Agent:Error\|Module:(\.+?)\|Message:(\.+?)\|Severity:(\w+)</regex>
  <order>data.module, data.error_message, data.severity</order>
</decoder>
