<group name="unwanted_software,">
  <!-- Rules 100500 - 100999: Exceptions/Rule Level Mod -->

  <!-- Rule 100500: Base Rule - Unallowed Software -->
  <rule id="100500" level="8">
    <if_sid>61603</if_sid>
    <field name="win.system.computer" negate="yes" type="pcre2">(?i)^((FIN|HR|CC|CYS|SSD|DSS|PRO|IPC|AON|OSS|IES|CMO|LEG|ADM|INO|))</field>
    <field name="win.eventdata.image" type="pcre2">(?i).*\\Users\\.*</field>
    <list field="win.eventdata.company" lookup="not_match_key">etc/lists/software_vendors</list>
    <description>Unauthorized software started:$(win.eventdata.product)</description>
    <mitre>
      <id>T1036</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <rule id="100501" level="12">
    <if_sid>100500</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i).*\\Users\\.*</field>
    <field name="win.eventdata.company">^N/A$</field>
    <description>Unsigned executable started from user space.</description>
    <group>sysmon_event1,software_policy</group>
    <options>no_full_log</options>
  </rule>

  <!-- Rule 100502: software-policy loop fix (2026-06-08). Exempt the active
       response's OWN PsTools in C:\Program Files\Sysinternals\ so launching
       pssuspend64/pskill64 to kill a blocked app does NOT re-trigger 100500
       and storm the AR. Matched rule becomes 100502 (not 100500), so the
       active response bound to 100500 no longer fires on these. Path-anchored:
       an attacker's PsTool run from anywhere else is still caught by 100500. -->
  <rule id="100502" level="3">
    <if_sid>100500</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\Sysinternals\\\\ps(suspend|kill|exec|info|list)\d*\.exe$</field>
    <description>Software-policy PsTools (own active-response tooling) - allowed, no active response.</description>
    <options>no_full_log</options>
    <group>sysmon_event1,software_policy,no_active_response</group>
  </rule>

  <!-- Common Unwanted Software Rules -->
  <rule id="100700" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.product" type="pcre2">(?i)(uTorrent|BitTorrent|qBittorrent|Deluge|Vuze)</field>
    <description>P2P File Sharing Software Detected: $(win.eventdata.product)</description>
    <mitre><id>T1190</id></mitre>
    <group>unwanted_software,p2p</group>
  </rule>

  <rule id="100701" level="9">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.product" type="pcre2">(?i)(TeamViewer|AnyDesk|Chrome Remote Desktop)</field>
    <description>Unauthorized Remote Access Tool Detected: $(win.eventdata.product)</description>
    <mitre><id>T1021</id></mitre>
    <group>unwanted_software,remote_access</group>
  </rule>

  <rule id="100702" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.product" type="pcre2">(?i)(XMRig|NiceHash|PhoenixMiner)</field>
    <description>Cryptominer Software Detected: $(win.eventdata.product)</description>
    <mitre><id>T1496</id></mitre>
    <group>unwanted_software,cryptominer</group>
  </rule>

  <rule id="100703" level="7">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.product" type="pcre2">(?i)(Nmap|Wireshark|Metasploit)</field>
    <description>Hacking/Penetration Testing Tool Detected: $(win.eventdata.product)</description>
    <mitre><id>T1595</id></mitre>
    <group>unwanted_software,hacking_tool</group>
  </rule>

  <!-- False Positive Handling Rules -->
  <rule id="100900" level="0">
    <if_sid>100701</if_sid>
    <field name="win.system.computer" type="pcre2">(?i)^IT-SUPPORT\d*(-|$)</field>
    <field name="win.eventdata.product" type="pcre2">(?i)(TeamViewer|AnyDesk)</field>
    <description>Ignoring authorized remote access tool on IT Support host: $(win.eventdata.product)</description>
    <group>unwanted_software,false_positive</group>
  </rule>

