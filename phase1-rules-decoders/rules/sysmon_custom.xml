<group name="sysmon">
  <!-- Generic Sysmon Event 1 (Process Creation) -->
  <rule id="100100" level="3">
    <if_sid>80700</if_sid> <!-- Sysmon Event 1 base rule -->
    <field name="win.eventdata.eventid">1</field>
    <description>Sysmon: Process created - $(win.eventdata.image)</description>
    <group>sysmon_event1,process_creation</group>
  </rule>

  <!-- Suspicious Process Chains (Event ID 1) -->
  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="win.eventdata.parentimage" type="pcre2">(?i)(cmd.exe|powershell.exe)</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(bitsadmin.exe|certutil.exe|mshta.exe|regsvr32.exe|rundll32.exe)</field>
    <description>Sysmon: Suspicious process chain detected - $(win.eventdata.parentimage) launched $(win.eventdata.image)</description>
    <mitre><id>T1059</id><id>T1218</id></mitre>
    <group>sysmon_event1,suspicious_process,lolbin</group>
  </rule>

  <!-- LOLBins (Living Off The Land Binaries) (Event ID 1) -->
  <rule id="100102" level="9">
    <if_sid>100100</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(powershell.exe|cmd.exe|wmic.exe|schtasks.exe|at.exe|net.exe|whoami.exe|findstr.exe|sc.exe|tasklist.exe|taskkill.exe|bitsadmin.exe|certutil.exe|mshta.exe|regsvr32.exe|rundll32.exe|forfiles.exe|fsutil.exe|makecab.exe|msiexec.exe|odbcconf.exe|pcalua.exe|pcwrun.exe|regasm.exe|regsvcs.exe|esentutl.exe|diskshadow.exe|vssadmin.exe|wscript.exe|cscript.exe)</field>
    <description>Sysmon: LOLBin execution detected - $(win.eventdata.image)</description>
    <mitre><id>T1218</id><id>T1059</id></mitre>
    <group>sysmon_event1,lolbin_execution</group>
  </rule>

  <!-- Generic Sysmon Event 3 (Network Connection) -->
  <rule id="100200" level="3">
    <if_sid>80703</if_sid> <!-- Sysmon Event 3 base rule -->
    <field name="win.eventdata.eventid">3</field>
    <description>Sysmon: Network connection - $(win.eventdata.image) to $(win.eventdata.destinationip):$(win.eventdata.destinationport)</description>
    <group>sysmon_event3,network_connection</group>
  </rule>

  <!-- Unusual Outbound Connections (Event ID 3) -->
  <rule id="100201" level="10">
    <if_sid>100200</if_sid>
    <field name="win.eventdata.destinationport" type="pcre2">(?i)(21|23|69|445)</field>
    <description>Sysmon: Unusual outbound connection to common C2/exfil port - $(win.eventdata.image) to $(win.eventdata.destinationip):$(win.eventdata.destinationport)</description>
    <mitre><id>T1071</id></mitre>
    <group>sysmon_event3,unusual_network_connection,c2</group>
  </rule>

  <!-- Generic Sysmon Event 11 (File Creation) -->
  <rule id="100300" level="3">
    <if_sid>80711</if_sid> <!-- Sysmon Event 11 base rule -->
    <field name="win.eventdata.eventid">11</field>
    <description>Sysmon: File created - $(win.eventdata.targetfilename)</description>
    <group>sysmon_event11,file_creation</group>
  </rule>

  <!-- Ransomware Indicators (Event ID 11) -->
  <rule id="100301" level="14">
    <if_sid>100300</if_sid>
    <field name="win.eventdata.targetfilename" type="pcre2">(?i)(\.lock$|\.encrypted$|\.crypt$|\.micro$|\.vvv$|\.xyz$|\.zzz$|\.aaa$|\.ccc$|\.enc$|\.wallet$|\.onion$|README.*\.txt$)</field>
    <description>Sysmon: Ransomware file extension created - $(win.eventdata.targetfilename)</description>
    <mitre><id>T1486</id></mitre>
    <group>sysmon_event11,ransomware</group>
  </rule>

  <!-- Generic Sysmon Event 13 (Registry Value Set) -->
  <rule id="100400" level="3">
    <if_sid>80713</if_sid> <!-- Sysmon Event 13 base rule -->
    <field name="win.eventdata.eventid">13</field>
    <description>Sysmon: Registry value set - $(win.eventdata.targetobject)</description>
    <group>sysmon_event13,registry_modification</group>
  </rule>

  <!-- Persistence Mechanisms (Event ID 13) -->
  <rule id="100401" level="12">
    <if_sid>100400</if_sid>
    <field name="win.eventdata.targetobject" type="pcre2">(?i)(.*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\.*|.*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\.*|.*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Windows\\Load|.*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Windows\\Run)</field>
    <description>Sysmon: Registry Run Key modified for persistence - $(win.eventdata.targetobject)</description>
    <mitre><id>T1547.001</id></mitre>
    <group>sysmon_event13,persistence</group>
  </rule>

  <!-- Generic Sysmon Event 7 (Image Loaded) -->
  <rule id="100500" level="3">
    <if_sid>80707</if_sid> <!-- Sysmon Event 7 base rule -->
    <field name="win.eventdata.eventid">7</field>
    <description>Sysmon: Image loaded - $(win.eventdata.image)</description>
    <group>sysmon_event7,image_load</group>
  </rule>

  <!-- DLL Hijacking (Event ID 7) -->
  <rule id="100501" level="11">
    <if_sid>100500</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(.*\\Users\\.*\\.*\.dll$|.*\\ProgramData\\.*\\.*\.dll$)</field>
    <description>Sysmon: Possible DLL Hijacking - DLL loaded from suspicious path: $(win.eventdata.image)</description>
    <mitre><id>T1574.001</id></mitre>
    <group>sysmon_event7,dll_hijacking</group>
  </rule>

  <!-- Generic Sysmon Event 8 (CreateRemoteThread) and 10 (ProcessAccess) -->
  <rule id="100600" level="3">
    <if_sid>80708</if_sid> <!-- Sysmon Event 8 base rule -->
    <field name="win.eventdata.eventid">8</field>
    <description>Sysmon: CreateRemoteThread detected - Source: $(win.eventdata.sourceimage) Target: $(win.eventdata.targetimage)</description>
    <group>sysmon_event8,process_injection</group>
  </rule>

  <rule id="100601" level="3">
    <if_sid>80710</if_sid> <!-- Sysmon Event 10 base rule -->
    <field name="win.eventdata.eventid">10</field>
    <description>Sysmon: ProcessAccess detected - Source: $(win.eventdata.sourceimage) Target: $(win.eventdata.targetimage)</description>
    <group>sysmon_event10,process_injection</group>
  </rule>

  <!-- Process Injection (Event ID 8, 10) -->
  <rule id="100602" level="13">
    <if_matched_sid>100600,100601</if_matched_sid>
    <field name="win.eventdata.sourceimage" type="pcre2">(?i)(.*\\explorer.exe|.*\\svchost.exe)</field>
    <field name="win.eventdata.targetimage" type="pcre2">(?i)(.*\\lsass.exe|.*\\winlogon.exe)</field>
    <description>Sysmon: Highly suspicious process injection - $(win.eventdata.sourceimage) to $(win.eventdata.targetimage)</description>
    <mitre><id>T1055</id></mitre>
    <group>sysmon_event8_10,process_injection,privilege_escalation</group>
  </rule>

</group>
