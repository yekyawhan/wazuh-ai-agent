
# Wazuh Manager API Credentials
WAZUH_MANAGER_IP=your_wazuh_manager_ip
WAZUH_API_PORT=55000
WAZUH_API_USER=your_wazuh_api_user
WAZUH_API_PASSWORD=your_wazuh_api_password

# Telegram Bot for Alerting
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=1721493612 # User's Telegram Chat ID

# AI Agent Configuration (used by ai-agent service)
# QDRANT_HOST and QDRANT_PORT are typically set by docker-compose for inter-service communication
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333

# Feedback Loop Configuration (used by feedback-loop service)
# FEEDBACK_PORT is typically set by docker-compose
# FEEDBACK_PORT=8001

# Training Data Collector Configuration (used by training_data_collector.py)
OUTPUT_FILE=wazuh_alerts.jsonl
DAYS_TO_EXPORT=30
MIN_ALERTS_TARGET=10000

# Data Labeler Configuration (used by data_labeler.py)
# INPUT_FILE=wazuh_alerts.jsonl
# OUTPUT_FILE=labeled_alerts.jsonl

# Training Pipeline Configuration (used by training_pipeline.py)
# LABELED_DATA_FILE=labeled_alerts.jsonl

# Test Simulator Configuration (used by test_simulator.py)
AI_AGENT_API_URL=http://localhost:8000/process_alert # Replace with actual AI Agent URL if not running locally
NUM_ALERTS_TO_SIMULATE=50

# Rollback Manager Configuration (if applicable)
# Add any specific environment variables for the rollback manager here
